# Copy to `.env` (or configure via `dotnet user-secrets` / host secret manager).
# Never commit real secrets to version control.

# PostgreSQL + PostGIS (matches backend/docker-compose.yml defaults for local dev)
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=farmflow;Username=postgres;Password=postgrespassword"

# Google OAuth 2.0 Web Application credentials (Google Cloud Console)
# Authorized redirect URI must point to: https://<api-host>/api/auth/google/callback
# (or http://localhost:<port>/api/auth/google/callback in local development)
Authentication__Google__ClientId="your-google-client-id.apps.googleusercontent.com"
Authentication__Google__ClientSecret="your-google-client-secret"

# Frontend return-URL allowlist & CORS origins (comma-indexed for ASP.NET Core configuration)
Auth__FrontendDefaultRedirectUrl="http://localhost:5173/"
Auth__AllowedRedirectOrigins__0="http://localhost:5173"
Cors__AllowedOrigins__0="http://localhost:5173"

# Optional NASA API tuning
NasaSettings__ForceMock=false
NasaSettings__TimeoutSeconds=3.0
